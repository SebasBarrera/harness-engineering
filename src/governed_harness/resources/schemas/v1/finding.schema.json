{
  "$defs": {
    "Actor": {
      "additionalProperties": false,
      "properties": {
        "actorId": {
          "pattern": "^[a-z][a-z0-9_.-]{1,127}$",
          "title": "Actorid",
          "type": "string"
        },
        "actorType": {
          "$ref": "#/$defs/ActorType"
        },
        "displayName": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Displayname"
        },
        "version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version"
        }
      },
      "required": [
        "actorType",
        "actorId"
      ],
      "title": "Actor",
      "type": "object"
    },
    "ActorType": {
      "enum": [
        "HUMAN",
        "AGENT",
        "TOOL",
        "PLUGIN",
        "HARNESS",
        "CI"
      ],
      "title": "ActorType",
      "type": "string"
    },
    "FindingLocation": {
      "additionalProperties": false,
      "properties": {
        "endLine": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Endline"
        },
        "path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Path"
        },
        "startLine": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Startline"
        }
      },
      "title": "FindingLocation",
      "type": "object"
    },
    "FindingSeverity": {
      "enum": [
        "INFO",
        "LOW",
        "MEDIUM",
        "HIGH",
        "CRITICAL"
      ],
      "title": "FindingSeverity",
      "type": "string"
    },
    "Provenance": {
      "additionalProperties": false,
      "properties": {
        "actor": {
          "$ref": "#/$defs/Actor"
        },
        "configurationDigest": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Configurationdigest"
        },
        "coreVersion": {
          "title": "Coreversion",
          "type": "string"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "pluginId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pluginid"
        },
        "pluginVersion": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pluginversion"
        },
        "policyDigest": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Policydigest"
        },
        "promptDigest": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Promptdigest"
        },
        "provider": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider"
        },
        "sourceRefs": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Sourcerefs",
          "type": "array"
        },
        "workflowDigest": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Workflowdigest"
        }
      },
      "required": [
        "actor",
        "coreVersion"
      ],
      "title": "Provenance",
      "type": "object"
    }
  },
  "$id": "https://example.org/governed-harness/schemas/v1/finding.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "category": {
      "title": "Category",
      "type": "string"
    },
    "createdAt": {
      "format": "date-time",
      "title": "Createdat",
      "type": "string"
    },
    "evidenceRefs": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Evidencerefs",
      "type": "array"
    },
    "executionId": {
      "title": "Executionid",
      "type": "string"
    },
    "findingId": {
      "title": "Findingid",
      "type": "string"
    },
    "introduced": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Introduced"
    },
    "location": {
      "anyOf": [
        {
          "$ref": "#/$defs/FindingLocation"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "message": {
      "title": "Message",
      "type": "string"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "recommendation": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Recommendation"
    },
    "ruleId": {
      "title": "Ruleid",
      "type": "string"
    },
    "schemaVersion": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schemaversion",
      "type": "string"
    },
    "severity": {
      "$ref": "#/$defs/FindingSeverity"
    },
    "validatorId": {
      "title": "Validatorid",
      "type": "string"
    }
  },
  "required": [
    "findingId",
    "executionId",
    "validatorId",
    "ruleId",
    "category",
    "severity",
    "message",
    "provenance"
  ],
  "title": "Finding",
  "type": "object"
}
