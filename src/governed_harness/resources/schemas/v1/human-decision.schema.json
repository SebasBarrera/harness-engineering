{
  "$defs": {
    "Actor": {
      "additionalProperties": false,
      "properties": {
        "actorId": {
          "pattern": "^[a-z][a-z0-9_.-]{1,127}$",
          "title": "Actorid",
          "type": "string"
        },
        "actorType": {
          "$ref": "#/$defs/ActorType"
        },
        "displayName": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Displayname"
        },
        "version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version"
        }
      },
      "required": [
        "actorType",
        "actorId"
      ],
      "title": "Actor",
      "type": "object"
    },
    "ActorType": {
      "enum": [
        "HUMAN",
        "AGENT",
        "TOOL",
        "PLUGIN",
        "HARNESS",
        "CI"
      ],
      "title": "ActorType",
      "type": "string"
    },
    "ChangeRequestItem": {
      "additionalProperties": false,
      "description": "A blocking item of a structured REQUEST_CHANGES: what must change and the condition\nthat verifies it. ``test:<pytest node id>`` must pass; ``absent:<regex>`` must not match\nany added line of the ChangeSet; ``text`` items are sent to the agent and shown to the\nreviewer but are not checked by a tool.",
      "properties": {
        "condition": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Condition",
          "type": "string"
        },
        "description": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "itemId": {
          "pattern": "^CR-[1-9][0-9]*$",
          "title": "Itemid",
          "type": "string"
        }
      },
      "required": [
        "itemId",
        "description",
        "condition"
      ],
      "title": "ChangeRequestItem",
      "type": "object"
    },
    "DecisionKind": {
      "enum": [
        "APPROVE",
        "REJECT",
        "REQUEST_CHANGES",
        "APPROVE_EXCEPTION"
      ],
      "title": "DecisionKind",
      "type": "string"
    }
  },
  "$id": "https://example.org/governed-harness/schemas/v1/human-decision.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "acceptanceContractDigest": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Acceptancecontractdigest"
    },
    "acknowledgedRisks": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Acknowledgedrisks",
      "type": "array"
    },
    "actor": {
      "$ref": "#/$defs/Actor"
    },
    "changeRequests": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ChangeRequestItem"
      },
      "title": "Changerequests",
      "type": "array"
    },
    "changeSetDigest": {
      "title": "Changesetdigest",
      "type": "string"
    },
    "checkedItems": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Checkeditems",
      "type": "array"
    },
    "configurationDigest": {
      "title": "Configurationdigest",
      "type": "string"
    },
    "decidedAt": {
      "format": "date-time",
      "title": "Decidedat",
      "type": "string"
    },
    "decision": {
      "$ref": "#/$defs/DecisionKind"
    },
    "decisionId": {
      "title": "Decisionid",
      "type": "string"
    },
    "executionId": {
      "title": "Executionid",
      "type": "string"
    },
    "expiresAt": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Expiresat"
    },
    "gateEvaluationId": {
      "title": "Gateevaluationid",
      "type": "string"
    },
    "identitySource": {
      "anyOf": [
        {
          "enum": [
            "explicit",
            "git",
            "fallback",
            "default"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Identitysource"
    },
    "policyDigest": {
      "title": "Policydigest",
      "type": "string"
    },
    "rationale": {
      "title": "Rationale",
      "type": "string"
    },
    "schemaVersion": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schemaversion",
      "type": "string"
    }
  },
  "required": [
    "decisionId",
    "executionId",
    "gateEvaluationId",
    "actor",
    "decision",
    "rationale",
    "changeSetDigest",
    "configurationDigest",
    "policyDigest"
  ],
  "title": "HumanDecision",
  "type": "object"
}
