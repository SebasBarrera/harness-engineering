{
  "$defs": {
    "Actor": {
      "additionalProperties": false,
      "properties": {
        "actorId": {
          "pattern": "^[a-z][a-z0-9_.-]{1,127}$",
          "title": "Actorid",
          "type": "string"
        },
        "actorType": {
          "$ref": "#/$defs/ActorType"
        },
        "displayName": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Displayname"
        },
        "version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version"
        }
      },
      "required": [
        "actorType",
        "actorId"
      ],
      "title": "Actor",
      "type": "object"
    },
    "ActorType": {
      "enum": [
        "HUMAN",
        "AGENT",
        "TOOL",
        "PLUGIN",
        "HARNESS",
        "CI"
      ],
      "title": "ActorType",
      "type": "string"
    }
  },
  "$id": "https://example.org/governed-harness/schemas/v1/human-attachment.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Evidence a person attached (a screenshot, a video, a log): stored as an artifact and\nbound to its digest, to the task revision (intake context) or to a run's ChangeSet and,\noptionally, to a checklist item.",
  "properties": {
    "actor": {
      "$ref": "#/$defs/Actor"
    },
    "artifactRef": {
      "title": "Artifactref",
      "type": "string"
    },
    "attachedAt": {
      "format": "date-time",
      "title": "Attachedat",
      "type": "string"
    },
    "attachmentId": {
      "title": "Attachmentid",
      "type": "string"
    },
    "changeSetDigest": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Changesetdigest"
    },
    "digest": {
      "title": "Digest",
      "type": "string"
    },
    "executionId": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Executionid"
    },
    "fileName": {
      "title": "Filename",
      "type": "string"
    },
    "itemId": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Itemid"
    },
    "mediaType": {
      "title": "Mediatype",
      "type": "string"
    },
    "note": {
      "anyOf": [
        {
          "maxLength": 2000,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Note"
    },
    "projectId": {
      "title": "Projectid",
      "type": "string"
    },
    "schemaVersion": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schemaversion",
      "type": "string"
    },
    "sizeBytes": {
      "minimum": 0,
      "title": "Sizebytes",
      "type": "integer"
    },
    "taskDigest": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Taskdigest"
    },
    "taskId": {
      "title": "Taskid",
      "type": "string"
    }
  },
  "required": [
    "attachmentId",
    "projectId",
    "taskId",
    "artifactRef",
    "digest",
    "mediaType",
    "sizeBytes",
    "fileName",
    "actor"
  ],
  "title": "HumanAttachment",
  "type": "object"
}
