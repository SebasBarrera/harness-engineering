{
  "$defs": {
    "Actor": {
      "additionalProperties": false,
      "properties": {
        "actorId": {
          "pattern": "^[a-z][a-z0-9_.-]{1,127}$",
          "title": "Actorid",
          "type": "string"
        },
        "actorType": {
          "$ref": "#/$defs/ActorType"
        },
        "displayName": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Displayname"
        },
        "version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version"
        }
      },
      "required": [
        "actorType",
        "actorId"
      ],
      "title": "Actor",
      "type": "object"
    },
    "ActorType": {
      "enum": [
        "HUMAN",
        "AGENT",
        "TOOL",
        "PLUGIN",
        "HARNESS",
        "CI"
      ],
      "title": "ActorType",
      "type": "string"
    },
    "ExceptionScope": {
      "additionalProperties": false,
      "description": "Findings an exception covers: a rule, optionally narrowed to a path and to one finding\nfingerprint (``reporting.fingerprint``).",
      "properties": {
        "fingerprint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fingerprint"
        },
        "path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Path"
        },
        "ruleId": {
          "minLength": 1,
          "title": "Ruleid",
          "type": "string"
        }
      },
      "required": [
        "ruleId"
      ],
      "title": "ExceptionScope",
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": false,
      "properties": {
        "actor": {
          "$ref": "#/$defs/Actor"
        },
        "configurationDigest": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Configurationdigest"
        },
        "coreVersion": {
          "title": "Coreversion",
          "type": "string"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "pluginId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pluginid"
        },
        "pluginVersion": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pluginversion"
        },
        "policyDigest": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Policydigest"
        },
        "promptDigest": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Promptdigest"
        },
        "provider": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider"
        },
        "sourceRefs": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Sourcerefs",
          "type": "array"
        },
        "workflowDigest": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Workflowdigest"
        }
      },
      "required": [
        "actor",
        "coreVersion"
      ],
      "title": "Provenance",
      "type": "object"
    }
  },
  "$id": "https://example.org/governed-harness/schemas/v1/exception.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A person's exception to blocking findings, recorded with ``APPROVE_EXCEPTION`` when\n``review.exceptions`` is on.\n\nIt is bound to the decision and the ChangeSet digest it was granted on, expires at\n``expires_at`` and covers the findings in ``scope``: while it is in force a later run of the\nproject does not block on them, and once it expires they block again. Alternative evidence\nand the follow-up are what the person declared; the harness records them, it does not check\nthem.",
  "properties": {
    "actor": {
      "$ref": "#/$defs/Actor"
    },
    "alternativeEvidence": {
      "anyOf": [
        {
          "maxLength": 4000,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Alternativeevidence"
    },
    "changeSetDigest": {
      "title": "Changesetdigest",
      "type": "string"
    },
    "decisionId": {
      "title": "Decisionid",
      "type": "string"
    },
    "exceptionId": {
      "title": "Exceptionid",
      "type": "string"
    },
    "executionId": {
      "title": "Executionid",
      "type": "string"
    },
    "expiresAt": {
      "format": "date-time",
      "title": "Expiresat",
      "type": "string"
    },
    "followUp": {
      "anyOf": [
        {
          "maxLength": 1000,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Followup"
    },
    "gateEvaluationId": {
      "title": "Gateevaluationid",
      "type": "string"
    },
    "grantedAt": {
      "format": "date-time",
      "title": "Grantedat",
      "type": "string"
    },
    "projectId": {
      "title": "Projectid",
      "type": "string"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "rationale": {
      "minLength": 1,
      "title": "Rationale",
      "type": "string"
    },
    "schemaVersion": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schemaversion",
      "type": "string"
    },
    "scope": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ExceptionScope"
      },
      "title": "Scope",
      "type": "array"
    }
  },
  "required": [
    "exceptionId",
    "projectId",
    "executionId",
    "decisionId",
    "gateEvaluationId",
    "actor",
    "rationale",
    "changeSetDigest",
    "expiresAt",
    "provenance"
  ],
  "title": "ExceptionRecord",
  "type": "object"
}
