{
  "$defs": {
    "Actor": {
      "additionalProperties": false,
      "properties": {
        "actorId": {
          "pattern": "^[a-z][a-z0-9_.-]{1,127}$",
          "title": "Actorid",
          "type": "string"
        },
        "actorType": {
          "$ref": "#/$defs/ActorType"
        },
        "displayName": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Displayname"
        },
        "version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version"
        }
      },
      "required": [
        "actorType",
        "actorId"
      ],
      "title": "Actor",
      "type": "object"
    },
    "ActorType": {
      "enum": [
        "HUMAN",
        "AGENT",
        "TOOL",
        "PLUGIN",
        "HARNESS",
        "CI"
      ],
      "title": "ActorType",
      "type": "string"
    },
    "Provenance": {
      "additionalProperties": false,
      "properties": {
        "actor": {
          "$ref": "#/$defs/Actor"
        },
        "configurationDigest": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Configurationdigest"
        },
        "coreVersion": {
          "title": "Coreversion",
          "type": "string"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "pluginId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pluginid"
        },
        "pluginVersion": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pluginversion"
        },
        "policyDigest": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Policydigest"
        },
        "promptDigest": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Promptdigest"
        },
        "provider": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider"
        },
        "sourceRefs": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Sourcerefs",
          "type": "array"
        },
        "workflowDigest": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Workflowdigest"
        }
      },
      "required": [
        "actor",
        "coreVersion"
      ],
      "title": "Provenance",
      "type": "object"
    },
    "Recommendation": {
      "additionalProperties": false,
      "properties": {
        "category": {
          "title": "Category",
          "type": "string"
        },
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "evidenceRefs": {
          "items": {
            "type": "string"
          },
          "title": "Evidencerefs",
          "type": "array"
        },
        "rationale": {
          "title": "Rationale",
          "type": "string"
        },
        "recommendationId": {
          "title": "Recommendationid",
          "type": "string"
        },
        "requiresHumanReview": {
          "default": true,
          "title": "Requireshumanreview",
          "type": "boolean"
        },
        "risk": {
          "enum": [
            "LOW",
            "MEDIUM",
            "HIGH"
          ],
          "title": "Risk",
          "type": "string"
        },
        "statement": {
          "title": "Statement",
          "type": "string"
        }
      },
      "required": [
        "recommendationId",
        "category",
        "statement",
        "rationale",
        "evidenceRefs",
        "confidence",
        "risk"
      ],
      "title": "Recommendation",
      "type": "object"
    },
    "RetrospectiveObservation": {
      "additionalProperties": false,
      "properties": {
        "evidenceRefs": {
          "items": {
            "type": "string"
          },
          "title": "Evidencerefs",
          "type": "array"
        },
        "observationId": {
          "title": "Observationid",
          "type": "string"
        },
        "statement": {
          "title": "Statement",
          "type": "string"
        }
      },
      "required": [
        "observationId",
        "statement",
        "evidenceRefs"
      ],
      "title": "RetrospectiveObservation",
      "type": "object"
    }
  },
  "$id": "https://example.org/governed-harness/schemas/v1/retrospective.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "appliedAutomatically": {
      "const": false,
      "default": false,
      "title": "Appliedautomatically",
      "type": "boolean"
    },
    "executionId": {
      "title": "Executionid",
      "type": "string"
    },
    "generatedAt": {
      "format": "date-time",
      "title": "Generatedat",
      "type": "string"
    },
    "observations": {
      "items": {
        "$ref": "#/$defs/RetrospectiveObservation"
      },
      "title": "Observations",
      "type": "array"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "recommendations": {
      "items": {
        "$ref": "#/$defs/Recommendation"
      },
      "title": "Recommendations",
      "type": "array"
    },
    "retrospectiveId": {
      "title": "Retrospectiveid",
      "type": "string"
    }
  },
  "required": [
    "retrospectiveId",
    "executionId",
    "observations",
    "recommendations",
    "provenance"
  ],
  "title": "Retrospective",
  "type": "object"
}
