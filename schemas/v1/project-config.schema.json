{
  "$defs": {
    "AgentProviderConfiguration": {
      "additionalProperties": false,
      "properties": {
        "command": {
          "items": {
            "type": "string"
          },
          "title": "Command",
          "type": "array"
        },
        "kind": {
          "const": "command",
          "default": "command",
          "title": "Kind",
          "type": "string"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        }
      },
      "required": [
        "command"
      ],
      "title": "AgentProviderConfiguration",
      "type": "object"
    },
    "CapabilitiesConfig": {
      "additionalProperties": false,
      "properties": {
        "default": {
          "const": "deny",
          "default": "deny",
          "title": "Default",
          "type": "string"
        },
        "grants": {
          "default": [],
          "items": {
            "$ref": "#/$defs/CapabilityRule"
          },
          "title": "Grants",
          "type": "array"
        }
      },
      "title": "CapabilitiesConfig",
      "type": "object"
    },
    "CapabilityRule": {
      "additionalProperties": false,
      "properties": {
        "approvalRequired": {
          "default": false,
          "title": "Approvalrequired",
          "type": "boolean"
        },
        "capability": {
          "title": "Capability",
          "type": "string"
        },
        "conditions": {
          "additionalProperties": true,
          "title": "Conditions",
          "type": "object"
        },
        "scope": {
          "items": {
            "type": "string"
          },
          "title": "Scope",
          "type": "array"
        }
      },
      "required": [
        "capability",
        "scope"
      ],
      "title": "CapabilityRule",
      "type": "object"
    },
    "FindingSeverity": {
      "enum": [
        "INFO",
        "LOW",
        "MEDIUM",
        "HIGH",
        "CRITICAL"
      ],
      "title": "FindingSeverity",
      "type": "string"
    },
    "IntakeConfig": {
      "additionalProperties": false,
      "description": "How INTENT treats acceptance criteria that cannot be observed.\n\n``enforce`` blocks INTENT until a person answers the clarification questions, ``warn``\nrecords the questions as evidence and low-severity findings and lets the run continue,\n``off`` skips the assessment.",
      "properties": {
        "criteriaPolicy": {
          "default": "warn",
          "enum": [
            "enforce",
            "warn",
            "off"
          ],
          "title": "Criteriapolicy",
          "type": "string"
        }
      },
      "title": "IntakeConfig",
      "type": "object"
    },
    "NotificationsConfig": {
      "additionalProperties": false,
      "description": "Webhooks notified when a run waits for a human decision or finishes (since 1.1).\nAbsent: nothing is sent, as in 1.0.0.",
      "properties": {
        "webhooks": {
          "default": [],
          "items": {
            "$ref": "#/$defs/WebhookConfig"
          },
          "title": "Webhooks",
          "type": "array"
        }
      },
      "title": "NotificationsConfig",
      "type": "object"
    },
    "RetrospectiveConfig": {
      "additionalProperties": false,
      "description": "With ``causal: true`` (since 1.1) the retrospective attributes every blocked gate and\ncorrection cycle to the reason code, validator or rule that caused it, ignores optional\nvalidators that had no effect on the gate, and is also generated when a run is rejected or\ncancelled. Absent or false keeps the 1.0.0 retrospective.",
      "properties": {
        "causal": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Causal"
        }
      },
      "title": "RetrospectiveConfig",
      "type": "object"
    },
    "ReviewConfig": {
      "additionalProperties": false,
      "description": "How a person's exceptions are recorded (since 1.1).\n\nWith ``exceptions: true`` an ``APPROVE_EXCEPTION`` decision records an exception with an\nexpiry, a scope (the findings it covers, by rule, path and fingerprint), optional\nalternative evidence and a follow-up. While it is in force, a later run of the project does\nnot block on the findings it covers; once it expires they block again, and a run waiting in\nDECISION on an expired exception is blocked. Absent or false keeps the 1.0.0 behaviour: an\nexception is a decision with a rationale and no expiry.",
      "properties": {
        "exceptionDays": {
          "anyOf": [
            {
              "maximum": 365,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Exceptiondays"
        },
        "exceptions": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Exceptions"
        }
      },
      "title": "ReviewConfig",
      "type": "object"
    },
    "RuntimeConfig": {
      "additionalProperties": false,
      "description": "Process bounds and, since 1.1, the agent sandbox and the feedback loop around the agent\nprovider.\n\nThe sandbox and loop settings are optional: a key that is absent keeps the 1.0.0 behaviour\nand is left out of the serialized configuration, so the snapshot digest of an existing\nproject does not change. ``harness init`` writes them.",
      "properties": {
        "agentSandbox": {
          "anyOf": [
            {
              "enum": [
                "enforce",
                "off"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Agentsandbox"
        },
        "allowNetwork": {
          "default": false,
          "title": "Allownetwork",
          "type": "boolean"
        },
        "commandTimeoutSeconds": {
          "default": 900,
          "minimum": 1,
          "title": "Commandtimeoutseconds",
          "type": "integer"
        },
        "maxOutputBytes": {
          "default": 1000000,
          "minimum": 1024,
          "title": "Maxoutputbytes",
          "type": "integer"
        },
        "maxParallel": {
          "default": 2,
          "maximum": 32,
          "minimum": 1,
          "title": "Maxparallel",
          "type": "integer"
        },
        "providerFeedback": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Providerfeedback"
        },
        "providerRetries": {
          "anyOf": [
            {
              "maximum": 10,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Providerretries"
        },
        "providerRetryDelaySeconds": {
          "anyOf": [
            {
              "maximum": 3600,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Providerretrydelayseconds"
        },
        "providerTransientPatterns": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Providertransientpatterns"
        },
        "sandboxWritePaths": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sandboxwritepaths"
        },
        "unsupportedClaimSeverity": {
          "anyOf": [
            {
              "$ref": "#/$defs/FindingSeverity"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "verificationCorrections": {
          "anyOf": [
            {
              "maximum": 10,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Verificationcorrections"
        }
      },
      "title": "RuntimeConfig",
      "type": "object"
    },
    "VerificationConfig": {
      "additionalProperties": false,
      "description": "What VERIFICATION does with identified requirements that no test names.\n\n``enforce`` records each one as a ``HIGH`` finding, which fails the gate under the default\n``findingBlockSeverities``; ``warn`` records it as a ``LOW`` finding; ``off`` skips the\ncheck.",
      "properties": {
        "outputParsers": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Outputparsers"
        },
        "requirementTraceability": {
          "default": "off",
          "enum": [
            "enforce",
            "warn",
            "off"
          ],
          "title": "Requirementtraceability",
          "type": "string"
        }
      },
      "title": "VerificationConfig",
      "type": "object"
    },
    "WebhookConfig": {
      "additionalProperties": false,
      "description": "A URL that receives a JSON ``POST`` when a run waits for a decision or finishes.\n\n``urlEnv`` names an environment variable that holds the URL, so a URL that carries a token\n(Slack, Teams) stays out of ``project.yaml`` and of the configuration snapshot. The payload\ncarries identifiers, statuses and digests only: no rationale, no output, no secret.",
      "properties": {
        "events": {
          "default": [
            "decision.pending",
            "run.finished"
          ],
          "items": {
            "enum": [
              "decision.pending",
              "run.finished"
            ],
            "type": "string"
          },
          "title": "Events",
          "type": "array"
        },
        "retries": {
          "default": 2,
          "maximum": 10,
          "minimum": 0,
          "title": "Retries",
          "type": "integer"
        },
        "timeoutSeconds": {
          "default": 5.0,
          "exclusiveMinimum": 0,
          "maximum": 60,
          "title": "Timeoutseconds",
          "type": "number"
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        },
        "urlEnv": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Urlenv"
        }
      },
      "title": "WebhookConfig",
      "type": "object"
    },
    "WorkspaceConfig": {
      "additionalProperties": false,
      "properties": {
        "root": {
          "default": "..",
          "title": "Root",
          "type": "string"
        },
        "units": {
          "default": [],
          "items": {
            "$ref": "#/$defs/WorkspaceUnitConfig"
          },
          "title": "Units",
          "type": "array"
        }
      },
      "title": "WorkspaceConfig",
      "type": "object"
    },
    "WorkspaceUnitConfig": {
      "additionalProperties": false,
      "properties": {
        "profile": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Profile"
        },
        "root": {
          "title": "Root",
          "type": "string"
        },
        "unitId": {
          "title": "Unitid",
          "type": "string"
        }
      },
      "required": [
        "unitId",
        "root"
      ],
      "title": "WorkspaceUnitConfig",
      "type": "object"
    }
  },
  "$id": "https://example.org/governed-harness/schemas/v1/project-config.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "agentProvider": {
      "default": "simulated",
      "title": "Agentprovider",
      "type": "string"
    },
    "agentProviders": {
      "additionalProperties": {
        "$ref": "#/$defs/AgentProviderConfiguration"
      },
      "title": "Agentproviders",
      "type": "object"
    },
    "capabilities": {
      "$ref": "#/$defs/CapabilitiesConfig"
    },
    "configVersion": {
      "const": "1.0",
      "title": "Configversion",
      "type": "string"
    },
    "intake": {
      "anyOf": [
        {
          "$ref": "#/$defs/IntakeConfig"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "notifications": {
      "anyOf": [
        {
          "$ref": "#/$defs/NotificationsConfig"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "policies": {
      "additionalProperties": true,
      "title": "Policies",
      "type": "object"
    },
    "profiles": {
      "default": [
        "auto"
      ],
      "items": {
        "type": "string"
      },
      "title": "Profiles",
      "type": "array"
    },
    "projectId": {
      "title": "Projectid",
      "type": "string"
    },
    "retention": {
      "additionalProperties": true,
      "title": "Retention",
      "type": "object"
    },
    "retrospective": {
      "anyOf": [
        {
          "$ref": "#/$defs/RetrospectiveConfig"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "review": {
      "anyOf": [
        {
          "$ref": "#/$defs/ReviewConfig"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "runtime": {
      "$ref": "#/$defs/RuntimeConfig"
    },
    "validators": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Validators",
      "type": "array"
    },
    "verification": {
      "anyOf": [
        {
          "$ref": "#/$defs/VerificationConfig"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "workflow": {
      "default": "default_development",
      "title": "Workflow",
      "type": "string"
    },
    "workspace": {
      "$ref": "#/$defs/WorkspaceConfig"
    }
  },
  "required": [
    "configVersion",
    "projectId",
    "workspace"
  ],
  "title": "ProjectConfiguration",
  "type": "object"
}
