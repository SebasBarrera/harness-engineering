{
  "$defs": {
    "Actor": {
      "additionalProperties": false,
      "properties": {
        "actorId": {
          "pattern": "^[a-z][a-z0-9_.-]{1,127}$",
          "title": "Actorid",
          "type": "string"
        },
        "actorType": {
          "$ref": "#/$defs/ActorType"
        },
        "displayName": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Displayname"
        },
        "version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version"
        }
      },
      "required": [
        "actorType",
        "actorId"
      ],
      "title": "Actor",
      "type": "object"
    },
    "ActorType": {
      "enum": [
        "HUMAN",
        "AGENT",
        "TOOL",
        "PLUGIN",
        "HARNESS",
        "CI"
      ],
      "title": "ActorType",
      "type": "string"
    },
    "DecisionKind": {
      "enum": [
        "APPROVE",
        "REJECT",
        "REQUEST_CHANGES",
        "APPROVE_EXCEPTION"
      ],
      "title": "DecisionKind",
      "type": "string"
    }
  },
  "$id": "https://example.org/governed-harness/schemas/v1/human-decision.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "actor": {
      "$ref": "#/$defs/Actor"
    },
    "changeSetDigest": {
      "title": "Changesetdigest",
      "type": "string"
    },
    "configurationDigest": {
      "title": "Configurationdigest",
      "type": "string"
    },
    "decidedAt": {
      "format": "date-time",
      "title": "Decidedat",
      "type": "string"
    },
    "decision": {
      "$ref": "#/$defs/DecisionKind"
    },
    "decisionId": {
      "title": "Decisionid",
      "type": "string"
    },
    "executionId": {
      "title": "Executionid",
      "type": "string"
    },
    "expiresAt": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Expiresat"
    },
    "gateEvaluationId": {
      "title": "Gateevaluationid",
      "type": "string"
    },
    "policyDigest": {
      "title": "Policydigest",
      "type": "string"
    },
    "rationale": {
      "title": "Rationale",
      "type": "string"
    },
    "schemaVersion": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schemaversion",
      "type": "string"
    }
  },
  "required": [
    "decisionId",
    "executionId",
    "gateEvaluationId",
    "actor",
    "decision",
    "rationale",
    "changeSetDigest",
    "configurationDigest",
    "policyDigest"
  ],
  "title": "HumanDecision",
  "type": "object"
}
