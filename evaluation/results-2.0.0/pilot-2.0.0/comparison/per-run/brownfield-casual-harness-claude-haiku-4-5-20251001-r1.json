e64 characters '+' (43) and '/' (47)\n+        if char_code == 43 or char_code == 47:\n+            raise BadData(\"Invalid base64-encoded data: invalid character found\")\n+\n+        # Valid URL-safe base64 characters: A-Z (65-90), a-z (97-122), 0-9 (48-57), '-' (45), '_' (95)\n+        if not (\n+            (65 <= char_code <= 90) or\n+            (97 <= char_code <= 122) or\n+            (48 <= char_code <= 57) or",
